FLASK_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-change-this-in-production
DATABASE_URL=sqlite:///pathfinding.db
# To switch to PostgreSQL (Render provides this automatically):
# DATABASE_URL=postgresql://user:password@localhost:5432/pathfinding
# CORS: comma-separated list of allowed origins (set to your Vercel URL in production)
CORS_ORIGINS=*
